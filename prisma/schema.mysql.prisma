// SHRIJAIV Organic - database schema
// MySQL / MariaDB version of the schema (for cPanel / Hostinger shared hosting).
// Copy this file over schema.prisma (see README -> "Using MySQL").

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  phone        String?
  nationality  String?
  passwordHash String
  role         String        @default("CUSTOMER") // ADMIN | EDITOR | CUSTOMER | SELLER | BUYER
  active       Boolean       @default(true)
  avatar       String? @db.Text
  resetToken   String?
  resetExpires DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  applications Application[]
  messages     Message[]
  leads        Lead[]
  seller       SellerProfile?
  buyer        BuyerProfile?
  inquiryMessages InquiryMessage[]
}

model Setting {
  key       String   @id
  value     String @db.LongText // JSON
  updatedAt DateTime @updatedAt
}

model Page {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  metaTitle       String?
  metaDescription String? @db.Text
  ogImage         String? @db.Text
  blocks          String @db.LongText // JSON array of blocks
  status          String   @default("published") // published | draft
  inMenu          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Post {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  excerpt         String? @db.Text
  content         String @db.LongText
  cover           String? @db.Text
  category        String    @default("Golden Visa UAE")
  tags            String?
  author          String    @default("Admin")
  status          String    @default("published")
  metaTitle       String?
  metaDescription String? @db.Text
  views           Int       @default(0)
  publishedAt     DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Service {
  id          String   @id @default(cuid())
  slug        String?
  title       String
  subtitle    String?
  description String? @db.Text
  price       String?
  icon        String?
  image       String? @db.Text
  link        String?
  category    String   @default("main") // main | additional
  featured    Boolean  @default(false)
  active      Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Faq {
  id        String   @id @default(cuid())
  question  String @db.Text
  answer    String @db.Text
  group     String   @default("home")
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String?
  country   String?
  rating    Int      @default(5)
  text      String @db.Text
  avatar    String? @db.Text
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Partner {
  id        String   @id @default(cuid())
  name      String
  logo      String? @db.Text
  url       String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lead {
  id          String   @id @default(cuid())
  name        String
  email       String?
  phone       String?
  nationality String?
  service     String?
  message     String? @db.Text
  source      String?
  status      String   @default("new") // new | contacted | qualified | converted | closed
  notes       String? @db.Text
  seen        Boolean  @default(false)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Application {
  id            String     @id @default(cuid())
  refNo         String     @unique
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  service       String
  fullName      String
  email         String?
  phone         String?
  nationality   String?
  passportNo    String?
  dateOfBirth   String?
  propertyValue String?
  familyMembers Int        @default(0)
  notes         String? @db.Text
  status        String     @default("submitted")
  progress      Int        @default(10)
  adminNote     String? @db.Text
  seen          Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  documents     Document[]
  messages      Message[]
}

model Document {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  name          String
  path          String
  mime          String?
  size          Int         @default(0)
  uploadedBy    String      @default("customer")
  createdAt     DateTime    @default(now())
}

model Message {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  senderId      String?
  sender        User?       @relation(fields: [senderId], references: [id], onDelete: SetNull)
  body          String @db.Text
  fromAdmin     Boolean     @default(false)
  read          Boolean     @default(false)
  createdAt     DateTime    @default(now())
}

model Media {
  id        String   @id @default(cuid())
  filename  String
  url       String @db.Text
  mime      String?
  size      Int      @default(0)
  alt       String?
  createdAt DateTime @default(now())
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Translation {
  id         String   @id @default(cuid())
  entity     String
  entityId   String
  locale     String
  data       String   @db.LongText
  status     String   @default("auto")
  sourceHash String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([entity, entityId, locale])
  @@index([locale])
}

model TranslationMemory {
  id        String   @id @default(cuid())
  key       String   @unique
  text      String   @db.Text
  createdAt DateTime @default(now())
}

// Uploaded files kept inside the database (used on hosts without a permanent disk, e.g. Vercel)
model StoredFile {
  id        String   @id @default(cuid())
  key       String   @unique @db.VarChar(191)
  data      Bytes    @db.LongBlob
  mime      String?
  size      Int      @default(0)
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------- AI chatbot (additive)
model ChatSession {
  id        String    @id @default(cuid())
  visitorId String    @default("")
  locale    String    @default("en")
  page      String    @db.Text
  status    String    @default("open")
  handedAt  DateTime?
  handover  String?
  leadId    String?
  name      String?
  phone     String?
  email     String?
  summary   String    @db.Text
  messages  String    @db.LongText
  count     Int       @default(0)
  ipHash    String    @default("")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([createdAt])
  @@index([status])
}

// ================================================================ Marketplace (SHRIJAIV Organic)

// Category tree: Organic Agriculture > Fruit > ... (unlimited depth, managed in Admin -> Categories)
model Category {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String?    @db.Text
  icon        String?
  image       String?    @db.Text
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  order       Int        @default(0)
  featured    Boolean    @default(false)
  active      Boolean    @default(true)
  metaTitle   String?
  metaDescription String? @db.Text
  products    Product[]
  requirements Requirement[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([parentId])
}

// Seller company profile (one per SELLER user). Public showroom at /seller/[slug]
model SellerProfile {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug          String    @unique
  companyName   String
  about         String?   @db.LongText
  logo          String?   @db.Text
  banner        String?   @db.Text
  businessType  String?   // manufacturer | wholesaler | exporter | farmer | trader | brand
  gstNumber     String?
  fssaiNumber   String?
  yearEstablished Int?
  employees     String?
  annualTurnover String?
  website       String?
  phone         String?
  whatsapp      String?
  email         String?
  address       String?   @db.Text
  city          String?
  state         String?
  pincode       String?
  country       String    @default("India")
  lat           Float?
  lng           Float?
  certifications String   @default("[]") // JSON [{ name, number, file }]
  status        String    @default("pending") // pending | approved | suspended | rejected
  verified      Boolean   @default(false)
  verifiedAt    DateTime?
  featured      Boolean   @default(false)
  ratingAvg     Float     @default(0)
  ratingCount   Int       @default(0)
  views         Int       @default(0)
  adminNote     String?   @db.Text
  seen          Boolean   @default(false)
  products      Product[]
  inquiries     Inquiry[]
  quotes        Quote[]
  reviews       Review[]
  subscriptions Subscription[]
  favourites    Favourite[]
  metaTitle     String?
  metaDescription String? @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([state])
}

// Buyer profile (one per BUYER user)
model BuyerProfile {
  id           String    @id @default(cuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName  String?
  buyerType    String?   // retailer | wholesaler | restaurant | exporter | individual | brand
  gstNumber    String?
  phone        String?
  whatsapp     String?
  address      String?   @db.Text
  city         String?
  state        String?
  pincode      String?
  country      String    @default("India")
  interests    String    @default("[]") // JSON category ids
  verified     Boolean   @default(false)
  status       String    @default("approved") // approved | suspended
  seen         Boolean   @default(false)
  requirements Requirement[]
  inquiries    Inquiry[]
  reviews      Review[]
  favourites   Favourite[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Product {
  id            String    @id @default(cuid())
  sellerId      String
  seller        SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  slug          String    @unique
  name          String
  summary       String?   @db.Text
  description   String?   @db.LongText
  images        String    @default("[]") // JSON [url]
  video         String?   @db.Text
  catalogFile   String?   @db.Text
  priceMin      Float?
  priceMax      Float?
  priceUnit     String?   // per kg | per litre | per piece | per quintal | per ton
  currency      String    @default("INR")
  moq           String?   // minimum order quantity, e.g. "100 kg"
  stock         String?   // in stock | made to order | limited
  specs         String    @default("[]") // JSON [{ label, value }]
  certifications String   @default("[]") // JSON [name]
  tags          String?
  origin        String?   // state / region
  brand         String?
  packaging     String?
  shelfLife     String?
  leadTime      String?
  status        String    @default("pending") // draft | pending | approved | rejected | hidden
  featured      Boolean   @default(false)
  views         Int       @default(0)
  inquiryCount  Int       @default(0)
  ratingAvg     Float     @default(0)
  ratingCount   Int       @default(0)
  adminNote     String?   @db.Text
  seen          Boolean   @default(false)
  metaTitle     String?
  metaDescription String? @db.Text
  inquiries     Inquiry[]
  reviews       Review[]
  favourites    Favourite[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([sellerId])
  @@index([categoryId])
  @@index([status])
}

// A buyer's posted requirement (Buy Lead / RFQ) at /requirements/[id]
model Requirement {
  id          String    @id @default(cuid())
  buyerId     String
  buyer       BuyerProfile @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  title       String
  details     String?   @db.LongText
  quantity    String?
  unit        String?
  budgetMin   Float?
  budgetMax   Float?
  currency    String    @default("INR")
  deliveryCity String?
  deliveryState String?
  neededBy    DateTime?
  attachments String    @default("[]") // JSON [url]
  status      String    @default("open") // pending | open | closed | expired | rejected
  featured    Boolean   @default(false)
  views       Int       @default(0)
  quoteCount  Int       @default(0)
  seen        Boolean   @default(false)
  adminNote   String?   @db.Text
  quotes      Quote[]
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([categoryId])
}

// A seller's quote on a requirement
model Quote {
  id            String      @id @default(cuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  sellerId      String
  seller        SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  price         Float?
  priceUnit     String?
  currency      String      @default("INR")
  quantity      String?
  deliveryTime  String?
  message       String?     @db.Text
  attachments   String      @default("[]")
  status        String      @default("sent") // sent | shortlisted | accepted | rejected | withdrawn
  seenByBuyer   Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([requirementId, sellerId])
}

// Buyer -> seller inquiry about a product (or the company). Has a chat thread.
model Inquiry {
  id          String    @id @default(cuid())
  refNo       String    @unique
  sellerId    String
  seller      SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  buyerId     String?
  buyer       BuyerProfile? @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  productId   String?
  product     Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  // guest details when the buyer is not logged in
  name        String
  email       String?
  phone       String?
  company     String?
  city        String?
  quantity    String?
  message     String    @db.Text
  status      String    @default("new") // new | replied | quoted | closed | spam
  contactUnlocked Boolean @default(true) // false when the seller's plan hides buyer contact details
  seenBySeller Boolean  @default(false)
  seenByBuyer  Boolean  @default(true)
  seenByAdmin  Boolean  @default(false)
  adminNote   String?   @db.Text
  messages    InquiryMessage[]
  lastMessageAt DateTime @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([sellerId])
  @@index([buyerId])
  @@index([status])
}

model InquiryMessage {
  id         String   @id @default(cuid())
  inquiryId  String
  inquiry    Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  senderId   String?
  sender     User?    @relation(fields: [senderId], references: [id], onDelete: SetNull)
  senderRole String   @default("buyer") // buyer | seller | admin | system
  body       String   @db.Text
  attachments String  @default("[]")
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([inquiryId])
}

// Ratings & reviews by buyers for a seller (optionally about one product)
model Review {
  id         String   @id @default(cuid())
  sellerId   String
  seller     SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  productId  String?
  product    Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  buyerId    String?
  buyer      BuyerProfile? @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  authorName String
  rating     Int      @default(5) // 1-5
  title      String?
  body       String   @db.Text
  images     String   @default("[]")
  reply      String?  @db.Text
  repliedAt  DateTime?
  status     String   @default("pending") // pending | approved | hidden | spam
  verifiedPurchase Boolean @default(false)
  helpful    Int      @default(0)
  seen       Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([sellerId])
  @@index([productId])
  @@index([status])
}

// Buyer favourites (saved products / sellers)
model Favourite {
  id        String   @id @default(cuid())
  buyerId   String
  buyer     BuyerProfile @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  sellerId  String?
  seller    SellerProfile? @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([buyerId, productId])
  @@unique([buyerId, sellerId])
}

// ---------------------------------------------------------------- Plans & payments
// Admin -> Plans & payments. The master switch "paidPlans" lives in Setting key "marketplace":
// OFF = every seller gets unlimited everything for free; ON = a seller needs an active plan.
model Plan {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  description   String?  @db.Text
  price         Float    @default(0) // INR, 0 = free plan
  period        String   @default("monthly") // monthly | quarterly | yearly | lifetime | custom
  periodDays    Int?     // for custom
  trialDays     Int      @default(0)
  audience      String   @default("seller") // seller | buyer
  // limits: -1 = unlimited
  maxProducts   Int      @default(-1)
  maxInquiries  Int      @default(-1) // inquiries whose buyer contact is unlocked per month
  maxQuotes     Int      @default(-1) // quotes on requirements per month
  maxImages     Int      @default(-1) // images per product
  featuredSlots Int      @default(0)
  verifiedBadge Boolean  @default(false)
  priorityRank  Int      @default(0) // higher = shown first in listings
  analytics     Boolean  @default(true)
  aiTools       Boolean  @default(true)
  features      String   @default("[]") // JSON [text] shown on the pricing page
  highlight     Boolean  @default(false) // "Most popular"
  autoRenew     Boolean  @default(true) // offer auto-renewal at checkout
  razorpayPlanId String?
  order         Int      @default(0)
  active        Boolean  @default(true)
  subscriptions Subscription[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Subscription {
  id           String   @id @default(cuid())
  sellerId     String
  seller       SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  planId       String
  plan         Plan     @relation(fields: [planId], references: [id])
  status       String   @default("active") // trial | active | past_due | cancelled | expired
  autoRenew    Boolean  @default(false)
  startsAt     DateTime @default(now())
  endsAt       DateTime?
  cancelledAt  DateTime?
  renewalReminderAt DateTime?
  razorpaySubscriptionId String?
  source       String   @default("razorpay") // razorpay | manual | free
  adminNote    String?  @db.Text
  payments     Payment[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([sellerId])
  @@index([status])
}

model Payment {
  id              String   @id @default(cuid())
  subscriptionId  String?
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  userId          String?
  amount          Float
  currency        String   @default("INR")
  gst             Float    @default(0)
  status          String   @default("created") // created | paid | failed | refunded
  provider        String   @default("razorpay") // razorpay | manual
  providerOrderId String?
  providerPaymentId String?
  method          String?  // upi | card | netbanking | wallet | emi | bank_transfer
  invoiceNo       String?  @unique
  couponCode      String?
  notes           String?  @db.Text
  raw             String?  @db.LongText
  paidAt          DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
}

model Coupon {
  id         String   @id @default(cuid())
  code       String   @unique
  type       String   @default("percent") // percent | flat
  value      Float
  maxUses    Int      @default(0) // 0 = unlimited
  used       Int      @default(0)
  planIds    String   @default("[]") // JSON [] = all plans
  startsAt   DateTime?
  endsAt     DateTime?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
}

// ---------------------------------------------------------------- Trust & admin
model Report {
  id         String   @id @default(cuid())
  reporterId String?
  targetType String   // seller | buyer | product | review | requirement
  targetId   String
  reason     String
  details    String?  @db.Text
  status     String   @default("open") // open | resolved | dismissed
  adminNote  String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// In-app notifications (bell) for sellers, buyers and admins
model Notification {
  id        String   @id @default(cuid())
  userId    String?  // null = all admins
  type      String   // inquiry | quote | review | product | seller | buyer | plan | payment | message | system
  title     String
  body      String?  @db.Text
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

// Who changed what in the admin (Admin -> Audit log)
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userName  String?
  action    String   // create | update | delete | approve | reject | login | ...
  entity    String
  entityId  String?
  summary   String?  @db.Text
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity])
  @@index([createdAt])
}

model Redirect {
  id        String   @id @default(cuid())
  from      String   @unique
  to        String
  code      Int      @default(301)
  hits      Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model SearchLog {
  id        String   @id @default(cuid())
  query     String
  results   Int      @default(0)
  locale    String   @default("en")
  createdAt DateTime @default(now())

  @@index([createdAt])
}
