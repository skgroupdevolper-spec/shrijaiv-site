{
  "name": "SHRIJAIV Organic (live preview)",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "hostRequirements": { "cpus": 2, "memory": "4gb" },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Website", "onAutoForward": "silent", "visibility": "public" }
  },
  "containerEnv": {
    "DATABASE_URL": "file:/workspaces/shrijaiv-data/data.db",
    "UPLOAD_DIR": "/workspaces/shrijaiv-data/uploads"
  },
  "postCreateCommand": "mkdir -p /workspaces/shrijaiv-data && npm install --no-audit --no-fund && npm run build",
  "postStartCommand": "bash .devcontainer/start.sh",
  "customizations": { "codespaces": { "openFiles": ["ADMIN-LOGIN.txt"] } }
}
